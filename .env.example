# Copy to `.env` and fill in (see: .env.example → cp .env.example .env)
# `build.sh` loads `.env` automatically when present.
#
# Vercel: add the same keys under Project → Settings → Environment Variables
# (Production + Preview; add Preview if you use branch deploys).

# ——— Client / build (injected into config.js by build.sh) ———
# Use VITE_CLOUDINARY_CLOUD_NAME, or set CLOUDINARY_CLOUD_NAME only (build.sh uses it as fallback).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=sigaram_gallery
VITE_ADMIN_PASSWORD=

# ——— Option B: folder listing in admin (/api/list-by-folder) ———
# Server-only: never commit real values; do not put these in config.js.
# Get API Key + Secret from Cloudinary → Dashboard → Programmable Media → API Keys.
#
# On Vercel, set at least:
#   CLOUDINARY_API_KEY
#   CLOUDINARY_API_SECRET
# CLOUDINARY_CLOUD_NAME is optional if VITE_CLOUDINARY_CLOUD_NAME is already set (same value).
# After deploy, open Admin → images in folders should load when tags are missing.
#
# Local: `npm run dev` runs dev-server.cjs (static + /api/list-by-folder) and loads this file via dotenv.
# If 5173 is busy, the dev server picks another free port — read the printed URL.
# Optional: PORT=5180 npm run dev  (or PORT=0 for OS-assigned only)
#
# Delete from admin uses POST /api/delete-resource (same API keys as folder listing).
# Use `npm run dev:static` for live-server only (no /api — admin folder fallback will not work).
# Or `npm run dev:vercel` after `vercel link`.
#
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
